{
  "name": "bottleneck",
  "private": true,
  "description": "Browser-based simulator that shows where a venue's entry and exit will jam before the event happens.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w @bottleneck/web",
    "build": "npm run build -w @bottleneck/web",
    "preview": "npm run preview -w @bottleneck/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "schema:gen": "node tools/generate-schema-types.mjs",
    "schema:check": "node tools/generate-schema-types.mjs --check",
    "api:schema:gen": "dotnet run --project apps/api/tools/Bottleneck.SchemaGen",
    "api:schema:check": "dotnet run --project apps/api/tools/Bottleneck.SchemaGen -- --check",
    "check": "npm run schema:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
