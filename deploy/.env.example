# Copy to <repo root>/.env on the VPS and fill in:
#   cp deploy/.env.example .env && chmod 600 .env
# .env is untracked (see .gitignore). Never commit real values. Keep values free of spaces, quotes,
# ';' and '#': generate secrets with `openssl rand -hex 24`.

# Public host name; Caddy obtains a Let's Encrypt certificate for it (DNS A/AAAA record must point
# at the VPS, ports 80 and 443 open).
DOMAIN=bottleneck.example.com
# Origin allowed to call the API from a browser (only needed if the frontend is served from a
# different origin, e.g. Vercel; the bundled Caddy serves both from one origin).
CORS_ORIGIN=https://bottleneck.example.com

POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# Simulation sidecar: parallel runs (2 vCPU: keep 1 or 2) and per-run memory cap.
SIDECAR_CONCURRENCY=1
SIDECAR_WORKER_MEMORY_MB=768

# Serve /scalar and /openapi publicly? Off in production unless you want public API docs.
API_DOCS_ENABLED=false

# ---- Backups (deploy/backup.sh, run nightly) ----
BACKUP_DIR=/var/backups/bottleneck
BACKUP_RETAIN_DAYS=14
# Encryption (required; the script refuses to write plaintext). Choose ONE:
#  a) public-key: the decryption key stays off the VPS (recommended). gpg --import the public key first.
BACKUP_GPG_RECIPIENT=
#  b) passphrase: path to a file (chmod 600) holding the passphrase; keep a copy off the VPS too.
BACKUP_PASSPHRASE_FILE=
# Off-box copy via rclone (https://rclone.org), e.g. "b2:bottleneck-backups/prod". Empty = local only.
BACKUP_RCLONE_REMOTE=
