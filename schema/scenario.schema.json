{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scenario.schema.json",
  "title": "Scenario",
  "description": "All inputs for one run against a venue. Times are seconds relative to t = 0; for fixed-start events t = 0 is the event start, for open-door events it is the opening time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "venueId",
    "name",
    "eventType",
    "timeline",
    "attendance",
    "carShare",
    "arrivals",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/definitions/Id"
    },
    "venueId": {
      "$ref": "common.schema.json#/definitions/Id"
    },
    "name": {
      "$ref": "common.schema.json#/definitions/Name"
    },
    "eventType": {
      "$ref": "#/definitions/EventType"
    },
    "timeline": {
      "$ref": "#/definitions/Timeline"
    },
    "attendance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    },
    "carShare": {
      "$ref": "common.schema.json#/definitions/Probability"
    },
    "arrivals": {
      "$ref": "#/definitions/DemandCurve"
    },
    "departures": {
      "$ref": "#/definitions/DemandCurve"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "parameters": {
      "$ref": "#/definitions/ScenarioParameters"
    },
    "overrides": {
      "description": "Per-element changes, keyed by element id (e.g. a different lane count for gate group 'gate-b').",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/Id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/ElementOverride"
      }
    },
    "timedEvents": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/definitions/TimedEvent"
      }
    }
  },
  "definitions": {
    "EventType": {
      "title": "EventType",
      "description": "Picks the arrival preset and which headline metrics apply. 'fair' is open-door (no fixed start).",
      "type": "string",
      "enum": [
        "concert",
        "stadium",
        "fair",
        "conference"
      ]
    },
    "Timeline": {
      "title": "Timeline",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceClock",
        "gatesOpen",
        "eventStart",
        "eventEnd",
        "horizon"
      ],
      "properties": {
        "referenceClock": {
          "description": "Wall-clock time of t = 0 for display, 24-hour 'HH:MM'.",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "gatesOpen": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "eventStart": {
          "description": "Fixed start, or null for open-door events.",
          "oneOf": [
            {
              "$ref": "common.schema.json#/definitions/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventEnd": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "horizon": {
          "$ref": "common.schema.json#/definitions/Seconds"
        }
      },
      "description": "horizon: the run stops here even if people are still queuing (it then reports not drained). eventStart is null for open-door events."
    },
    "DemandCurve": {
      "title": "DemandCurve",
      "description": "How arrivals (or departures) spread over time: a named preset, optionally replaced by points that the UI smooths into a curve.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "concert",
            "stadium",
            "fair",
            "conference",
            "custom"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "t",
              "weight"
            ],
            "properties": {
              "t": {
                "$ref": "common.schema.json#/definitions/Seconds"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "ScenarioParameters": {
      "title": "ScenarioParameters",
      "description": "Scenario-scope assumptions (spec section 5). Missing values use the built-in defaults (all assumed); the run stores the full resolved set. nearestLaneShare: share of people who take the lane with the shortest walk instead of choosing by expected cost (default 0.3). manualLaneServiceTime: service time at a gate group manual lane, used after a second scan failure (default uniform 20-40 s). shareInsideAt: reference time T of the share-inside-by-T metric, in scenario seconds (default 10 minutes before a fixed start, or 1 hour after the gates open for open-door events).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freeWalkingSpeed": {
          "$ref": "common.schema.json#/definitions/Distribution"
        },
        "nearestLaneShare": {
          "$ref": "common.schema.json#/definitions/Probability"
        },
        "decisionDistance": {
          "description": "People choose a lane once the walk to the nearest lane of their stage is at most this many metres (default 20, assumed).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "logitScale": {
          "description": "Logit scale τ of the lane choice in seconds: a lane whose walk plus expected wait costs τ seconds more is e times less likely to be chosen (default 15, assumed).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "slotSpacing": {
          "description": "Distance between people standing in a queue line, in metres (default 0.6, assumed).",
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "jockeyThreshold": {
          "description": "A queued person switches lane (at most once per stage) only to a lane with at least this many fewer people (default 3, assumed).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "manualLaneServiceTime": {
          "$ref": "common.schema.json#/definitions/Distribution"
        },
        "watchdogMinutes": {
          "description": "Deadlock watchdog: the run stops if nothing changes for this many simulated minutes (default 10).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "shareInsideAt": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "groupSizes": {
          "description": "People arrive in groups that walk together and choose the same lane. groupSizes[k] is the relative frequency of groups of k + 1 people (default [0.30, 0.40, 0.15, 0.10, 0.05] for sizes 1-5, assumed). [1] means everyone arrives alone.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "bagPolicy": {
          "$ref": "#/definitions/BagPolicy"
        }
      }
    },
    "BagPolicy": {
      "title": "BagPolicy",
      "description": "Bag policy at the screening stages; picks their service time (assumed values): 'none' (walk-through only, mean 2.5 s, at least 1.5 s), 'clearBag' (clear bags only, mean 4 s, at least 2 s), 'fullSearch' (every bag searched, mean 10 s, at least 4 s). Unset: the venue's own screening times. An element override's serviceTime still wins.",
      "type": "string",
      "enum": [
        "none",
        "clearBag",
        "fullSearch"
      ]
    },
    "ElementOverride": {
      "title": "ElementOverride",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "laneCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "serviceTime": {
          "$ref": "common.schema.json#/definitions/Distribution"
        },
        "scanFailureRate": {
          "$ref": "common.schema.json#/definitions/Probability"
        }
      }
    },
    "TimedEvent": {
      "title": "TimedEvent",
      "oneOf": [
        {
          "$ref": "#/definitions/LaneFailEvent"
        },
        {
          "$ref": "#/definitions/LaneReopenEvent"
        },
        {
          "$ref": "#/definitions/BusBurstEvent"
        }
      ]
    },
    "LaneFailEvent": {
      "title": "LaneFailEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "at",
        "groupId",
        "laneIndex"
      ],
      "properties": {
        "kind": {
          "const": "laneFail"
        },
        "at": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "groupId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "laneIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      }
    },
    "LaneReopenEvent": {
      "title": "LaneReopenEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "at",
        "groupId",
        "laneIndex"
      ],
      "properties": {
        "kind": {
          "const": "laneReopen"
        },
        "at": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "groupId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "laneIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      }
    },
    "BusBurstEvent": {
      "title": "BusBurstEvent",
      "description": "N people appear at once at a source (a full bus or tram arriving).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "at",
        "sourceId",
        "count"
      ],
      "properties": {
        "kind": {
          "const": "busBurst"
        },
        "at": {
          "$ref": "common.schema.json#/definitions/Seconds"
        },
        "sourceId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    }
  }
}
