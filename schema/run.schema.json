          "type": "integer",
          "minimum": 0
        },
        "departedCars": {
          "type": "integer",
          "minimum": 0
        },
        "firstDepartureAt": {
          "description": "First person who left the site (on foot or in a car).",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastDepartureAt": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ParkingMetrics": {
      "title": "ParkingMetrics",
      "description": "Cars and parking (spec 4.5, Parking). Times are scenario times.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carCount",
        "carCountsByState",
        "carPeople",
        "turnedAwayCars",
        "divertedCars",
        "turnedAwayPeople",
        "maxSourceBacklog",
        "lots",
        "barriers",
        "barrierLanes"
      ],
      "properties": {
        "carCount": {
          "type": "integer",
          "minimum": 0
        },
        "carCountsByState": {
          "description": "Cars per AgentState: Pending (not yet on the road), Driving, Parked, Departed, TurnedAway, Diverted (driving to its second lot); the other states are always 0.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "carPeople": {
          "description": "People who came by car.",
          "type": "integer",
          "minimum": 0
        },
        "turnedAwayCars": {
          "type": "integer",
          "minimum": 0
        },
        "divertedCars": {
          "description": "Cars redirected to another lot (each at most once).",
          "type": "integer",
          "minimum": 0
        },
        "turnedAwayPeople": {
          "description": "Occupants of turned-away cars (also counted as TurnedAway in countsByState).",
          "type": "integer",
          "minimum": 0
        },
        "maxSourceBacklog": {
          "description": "Most cars at once that could not yet enter the road network at their source (the queue reached beyond the model).",
          "type": "integer",
          "minimum": 0
        },
        "lots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LotReport"
          }
        },
        "barriers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BarrierReport"
          }
        },
        "barrierLanes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BarrierLaneReport"
          }
        }
      }
    },
    "LotReport": {
      "title": "LotReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lotId",
        "stalls",
        "parked",
        "maxOccupancy",
        "occupancy",
        "meanSearchTime",
        "turnedAway",
        "divertedAway",
        "divertedIn",
        "closedAt",
        "emptyAt",
        "timeToEmpty"
      ],
      "properties": {
        "lotId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "stalls": {
          "type": "integer",
          "minimum": 0
        },
        "parked": {
          "description": "Cars that parked in this lot.",
          "type": "integer",
          "minimum": 0
        },
        "maxOccupancy": {
          "type": "integer",
          "minimum": 0
        },
        "occupancy": {
          "description": "Cars in stalls at the end of each throughputBin, bins from engine time 0.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "meanSearchTime": {
          "description": "Mean seconds from passing the entry barrier to standing in the stall.",
          "type": "number",
          "minimum": 0
        },
        "turnedAway": {
          "description": "Cars this lot turned away (rule leave, or a diverted car arriving full).",
          "type": "integer",
          "minimum": 0
        },
        "divertedAway": {
          "type": "integer",
          "minimum": 0
        },
        "divertedIn": {
          "type": "integer",
          "minimum": 0
        },
        "closedAt": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "emptyAt": {
          "description": "When the last car of the departure rush left the lot (passed its exit barrier); null if no departures or not empty by the end.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeToEmpty": {
          "description": "emptyAt minus the event end, in seconds (spec 4.4 headline).",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BarrierReport": {
      "title": "BarrierReport",
      "description": "Queue in front of one barrier group, measured along the road from the stop line to the back of the last queued car (spec 4.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "barrierId",
        "kind",
        "lotId",
        "maxQueueCars",
        "maxQueueMetres",
        "maxQueueAt",
        "meanQueueMetres",
        "reachedPublicRoadAt"
      ],
      "properties": {
        "barrierId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entry",
            "exit"
          ]
        },
        "lotId": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxQueueCars": {
          "type": "integer",
          "minimum": 0
        },
        "maxQueueMetres": {
          "type": "number",
          "minimum": 0
        },
        "maxQueueAt": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "meanQueueMetres": {
          "description": "Time average of the queue length in metres over the barrier's reporting window: from the first car joining one of its lanes to the last service start, like its lanes' LaneMetrics (sampled every tick).",
          "type": "number",
          "minimum": 0
        },
        "reachedPublicRoadAt": {
          "description": "First time a queued car stood on a public road (or could not enter the model at its source); null if never.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BarrierLaneReport": {
      "title": "BarrierLaneReport",
      "description": "One barrier lane, with the same queueing statistics as a pedestrian lane (Wq from joining the lane's approach to service start).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laneId",
        "barrierId",
        "kind",
        "laneIndex",
        "metrics",
        "throughput",
        "queueLength"
      ],
      "properties": {
        "laneId": {
          "type": "integer",
          "minimum": 0
        },
        "barrierId": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entry",
            "exit"
          ]
        },
        "laneIndex": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/definitions/LaneMetrics"
        },
        "throughput": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "queueLength": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
