              "$ref": "common.schema.json#/definitions/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "meanBusyTime": {
          "description": "Expected seconds a lane is busy per car, including misread fallbacks.",
          "type": "number",
          "minimum": 0
        }
