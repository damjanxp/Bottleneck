<Project>
  <ItemGroup>
    <!-- Schema: code generation (tool only) and validation -->
    <PackageVersion Include="NJsonSchema.CodeGeneration.CSharp" Version="11.6.2" />
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Images: SkiaSharp (MIT) is the D5 fallback; ImageSharp 3.2+/4 need a licence key at build time. -->
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
