<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test names read better with underscores; async suffixes are noise in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1001;CA1861;CA2000;CA1849;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Bottleneck.Api/Bottleneck.Api.csproj" />
    <ProjectReference Include="../../src/Bottleneck.Schema/Bottleneck.Schema.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same fixture files the TypeScript tests load (spec section 8: "loaded by both test suites"). -->
    <None Include="$(RepoRoot)schema/fixtures/**/*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- The built-in examples the job tests run, and the TypeScript statistics the C# port must equal. -->
    <None Include="$(RepoRoot)packages/examples/venues/*.json" LinkBase="examples/venues" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)packages/examples/scenarios/*.json" LinkBase="examples/scenarios" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)packages/analysis/src/stats.ts" LinkBase="analysis" CopyToOutputDirectory="PreserveNewest" />
    <!-- Generated by apps/api/test/expected-hashes.test.ts (npm run api:hashes:gen). -->
    <None Update="Jobs/expected-hashes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
