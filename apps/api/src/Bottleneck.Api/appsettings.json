{
  "ConnectionStrings": {
    "Bottleneck": "Host=localhost;Port=5432;Database=bottleneck;Username=bottleneck;Password=bottleneck-dev"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Limits": {
    "MaxVenueBytes": 1048576,
    "MaxScenarioBytes": 262144,
    "MaxClientRunBytes": 262144,
    "MaxJsonDepth": 32,
    "MaxJsonNodes": 200000,
    "MaxScenariosPerVenue": 100,
    "MaxClientRunsPerVenue": 50,
    "MaxVenues": 2000
  },
  "Uploads": {
    "Path": "storage/uploads",
    "MaxBytes": 5242880,
    "MaxSide": 4096,
    "MaxUploadsPerVenue": 20,
    "VenueQuotaBytes": 26214400,
    "GlobalQuotaBytes": 2147483648,
    "JpegQuality": 90,
    "MaxConcurrentDecodes": 2
  },
  "RateLimits": {
    "Global": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Writes": { "PermitLimit": 60, "WindowSeconds": 60 },
    "CreateVenue": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "Uploads": { "PermitLimit": 20, "WindowSeconds": 600 }
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Retention": {
    "Enabled": true,
    "InactiveDays": 90,
    "IntervalMinutes": 360,
    "BatchSize": 100
  },
  "OpenApi": {
    "Enabled": true
  }
}
